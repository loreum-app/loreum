{
  "extends": "@loreum/typescript-config/nestjs.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "isolatedModules": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "generated/prisma": ["./generated/prisma"]
    }
  },
  "include": ["src/**/*.ts", "generated/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
