# Database
DATABASE_URL=postgresql://lorekeeper:lorekeeper_dev@localhost:5432/lorekeeper
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL=2h
TOKEN_ROTATION_MINUTES=100
SESSION_TTL_DAYS=60
COOKIE_DOMAIN=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3021/v1/auth/google/callback

# # OAuth - Discord (uncomment when ready)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=http://localhost:3021/v1/auth/discord/callback

# # OAuth - Microsoft (uncomment when ready)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=http://localhost:3021/v1/auth/microsoft/callback

# CORS
CORS_ORIGIN=http://localhost:3020
API_PORT=3021

# Public URLs (MCP + OAuth). PUBLIC_API_URL must be exactly what MCP clients
# connect to (it is the OAuth issuer and the base of every MCP resource URL).
PUBLIC_API_URL=http://localhost:3021
WEB_URL=http://localhost:3020
# Optional: extra OAuth redirect URIs accepted for any client (comma separated)
OAUTH_ALLOWED_REDIRECT_URIS=
# Optional: MCP OAuth token lifetimes (seconds)
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=7776000

# Billing / plans. Dormant by default: every account gets every feature.
BILLING_ENABLED=false

# Swagger (requires ENABLE_SWAGGER=true, never enabled in production)
ENABLE_SWAGGER=true
