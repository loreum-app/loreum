{
  "name": "loreum",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@loreum/eslint-config": "workspace:*",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --ignore-path .gitignore",
      "eslint --fix --max-warnings 25"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write --ignore-path .gitignore"
    ]
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  }
}
